# Copy this file to .env and edit. Never commit .env.

# true = use an LLM, false = built-in rule-based analyst (no LLM needed)
USE_LLM=true

# --- Option B: local LLM with LM Studio (default) ---
LLM_BASE_URL=http://localhost:1234/v1
LLM_MODEL=qwen2.5-7b-instruct
LLM_API_KEY=lm-studio

# --- Option A: cloud API (example: OpenAI) ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-your-key-here

LLM_TEMPERATURE=0.1
MAX_FILE_MB=20
